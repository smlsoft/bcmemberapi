{
  "version": 2,
  "builds": [
    {
      "src": "api/login/code.go",
      "use": "@vercel/go"
    },
    {
      "src": "api/login/status.go",
      "use": "@vercel/go"
    },
    {
      "src": "api/callback.go",
      "use": "@vercel/go"
    },
    {
      "src": "api/saleinvoice/index.go",
      "use": "@vercel/go"
    },
    {
      "src": "api/recal-points/index.go",
      "use": "@vercel/go"
    },
    {
      "src": "api/send-receipt/index.go",
      "use": "@vercel/go"
    }
  ],
  "routes": [
    {
      "src": "/api/login/code",
      "dest": "/api/login/code.go",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/api/login/status",
      "dest": "/api/login/status.go",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/callback",
      "dest": "/api/callback.go",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/callback",
      "dest": "/api/callback.go",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/api/saleinvoice",
      "dest": "/api/saleinvoice/index.go",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/api/recal-points",
      "dest": "/api/recal-points/index.go",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/api/send-receipt",
      "dest": "/api/send-receipt/index.go",
      "methods": ["POST", "OPTIONS"]
    }
  ],
  "env": {
    "GO111MODULE": "on"
  }
}
